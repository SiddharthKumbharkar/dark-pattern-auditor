# Copy to .env in this same directory (python-dotenv loads it
# automatically -- no shell export needed). Pick ONE of the two option
# blocks below, matching however GPT-4o is actually exposed in this TCS
# workspace. Do not guess which one applies -- ask whoever set up the
# workspace if you're not sure, rather than filling in both.

# --- Option A: Azure OpenAI ---
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT=<your gpt-4o deployment name>

# --- Option B: OpenAI-compatible endpoint ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AttributeResult judgement for 'covertness' (Stage 2, LLM)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attribute",
    "verdict",
    "severity",
    "confidence",
    "evidence_pointers",
    "reasoning"
  ],
  "properties": {
    "attribute": {
      "const": "covertness"
    },
    "verdict": {
      "enum": [
        "fires",
        "no",
        "unsure",
        "not_assessable"
      ]
    },
    "severity": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "evidence_pointers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "selector",
          "signal"
        ],
        "properties": {
          "step_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "selector": {
            "type": [
              "string",
              "null"
            ]
          },
          "signal": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reasoning": {
      "type": "string",
      "minLength": 1
    }
  }
}
# Copy this file to .env (already gitignored -- your real values never
# get committed). Only needed for commands that call an LLM:
# `auto_audit.py` / `dpa.py auto-audit`, and `record.py --auto-audit`.
# Every other command (record, extract-evidence, run-attributes,
# build-output, report, build-payload, ...) is free, local computation
# and needs no key/cookie at all.
#
# python-dotenv loads this automatically from the project root -- no
# shell export needed. If you'd rather not use a .env file, exporting
# these in your shell works exactly the same way.

# Which LLM backend auto_audit.py / record.py --auto-audit use -- see
# llm/backends/factory.py. "tcs_gpt4o" (the default, used when this var
# is unset) needs the TCS_* vars below; "anthropic" needs
# ANTHROPIC_API_KEY instead.
LLM_BACKEND=tcs_gpt4o

# --- tcs_gpt4o backend (default) ---
# TCS_LLM_URL is the FULL code-server proxy base for the server/ relay
# running inside your TCS workspace -- everything up to (not including)
# "/execute", e.g.:
#   https://rniazure.tcsapps.com/dev-workspaces/<your-workspace-id>/proxy/8000
# TCS_SESSION_COOKIE is the value of the code-server-session cookie your
# browser holds while logged into that workspace -- it expires, so
# you'll need to refresh this value periodically (llm/backends/
# tcs_gpt4o_backend.py raises a clear error telling you to when it has).
TCS_LLM_URL=https://rniazure.tcsapps.com/dev-workspaces/your-workspace-id/proxy/8000
TCS_SESSION_COOKIE=your-code-server-session-cookie-value
# Optional tuning, both have sane defaults (see llm/backends/tcs_gpt4o_backend.py):
# TCS_TIMEOUT_SECONDS=120
# TCS_MAX_RETRIES=3

# --- anthropic backend (opt-in: LLM_BACKEND=anthropic) ---
# Get a key at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- server/ (the TCS GPT-4o relay itself) ---
# These are consumed by server/app.py INSIDE the TCS workspace, not by
# this client repo -- documented here too only so it's obvious which
# process reads what. See server/.env.example for the real copy-to-.env
# file (next to server/app.py).
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT=<your gpt-4o deployment name>
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o
